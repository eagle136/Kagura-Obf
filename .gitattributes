# Normalize text files to LF in the repository
* text=auto eol=lf

# Windows scripts must be checked out with CRLF for cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts
*.png binary
*.jpg binary
*.ico binary
*.so binary
*.dll binary
*.dylib binary
*.lib binary
*.a binary
*.exe binary
*.bc binary
